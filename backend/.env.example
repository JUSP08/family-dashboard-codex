APP_HOST=0.0.0.0
APP_PORT=8099
DASHBOARD_TIMEZONE=America/New_York
# Must be changed before LAN use. The current keypad accepts four digits.
DASHBOARD_ADMIN_PIN=0000
DASHBOARD_SECRET_KEY=replace-with-a-long-random-value
MAX_TIME_BALANCE_MINUTES=150

# Leave unset to use backend/data/family_dashboard.db reliably from any working directory.
# SQLITE_PATH=C:/family-dashboard-codex/backend/data/family_dashboard.db

HA_URL=http://192.168.50.50:8123
HA_TOKEN=your-home-assistant-long-lived-access-token
# Optional comma-separated entity IDs. Leave blank to show all supported entities.
HA_ENTITY_ALLOWLIST=
HA_REDEMPTION_WEBHOOK_ID=redemption_notice
HA_REWARD_WEBHOOK_ID=family_dashboard_reward
HA_NOTIFY_TIMEOUT_SECONDS=20

QUSTODIO_EMAIL=your-email@example.com
QUSTODIO_PW=your-password
QUSTODIO_TOKEN=your-bearer-token
QUSTODIO_ACCOUNT_UID=your-account-uid
QUSTODIO_PROFILES_JSON={"child-name":"profile-uid"}
QUSTODIO_TIMEOUT_SECONDS=20
QUSTODIO_HEADLESS=true

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_POOL_TIMEOUT_SECONDS=90
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_THEME_TIMEOUT_SECONDS=180
GEMINI_THEME_IMAGE_SIZE=2K

GOOGLE_API_KEY=your-restricted-google-calendar-api-key
GOOGLE_TIMEOUT_SECONDS=20

LOG_LEVEL=INFO
